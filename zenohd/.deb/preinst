#!/bin/sh
# preinst script for Eclipse Zenoh
# see: dh_installdeb(1)

set -e

# summary of how this script can be called:
#        * <new-preinst> `install'
#        * <new-preinst> `install' <old-version>
#        * <new-preinst> `upgrade' <old-version>
#        * <old-preinst> `abort-upgrade' <new-version>
# for details, see https://www.debian.org/doc/debian-policy/ or
# the debian-policy package


case "$1" in
    install|upgrade)
        # The postrm of zenohd 1.10.1 and earlier deletes /etc/zenohd and
        # /var/zenohd during upgrades (#2778), and dpkg runs that old postrm
        # after unpacking this package. Snapshot both directories with hard
        # links (no data is copied) so that postinst can restore them.
        for dir in /etc/zenohd /var/zenohd; do
            # A snapshot without its directory is left by an upgrade that
            # stopped before postinst. Restore it before dpkg unpacks again,
            # since the unpack recreates /etc/zenohd.
            if [ ! -e "$dir" ] && [ -d "$dir.dpkg-backup" ]; then
                mv "$dir.dpkg-backup" "$dir"
            fi
            if [ "$1" = upgrade ] && [ -d "$dir" ]; then
                rm -rf "$dir.dpkg-backup"
                cp -al "$dir" "$dir.dpkg-backup"
            fi
        done
    ;;

    abort-upgrade)
    ;;

    *)
        echo "preinst called with unknown argument \`$1'" >&2
        exit 1
    ;;
esac

# dh_installdeb will replace this with shell code automatically
# generated by other debhelper scripts.

#DEBHELPER#

exit 0
